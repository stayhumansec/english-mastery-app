rules_version = '2';

// Each signed-in user can only read/write documents under their own uid.
// The app stores exactly one document per user right now
// (users/{uid}/backup/current — see src/lib/cloudBackup.ts), but this
// rule covers the whole users/{uid}/** subtree so it keeps working if
// more per-user collections are added later.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
